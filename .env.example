# ============================================================================
# CONFIGURARE SUPABASE (Copiază acest fișier în .env.local și completează valorile)
# ============================================================================
# Găsești aceste două valori în Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://PROIECTUL-TAU.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cheia-ta-anon-publica-aici

# Opțional — necesar doar pentru webhook-uri server-to-server (ex. Stripe Webhooks)
# NU expune niciodată această cheie în browser (fără prefix NEXT_PUBLIC_)!
# SUPABASE_SERVICE_ROLE_KEY=cheia-ta-service-role-secreta-aici

# URL-ul aplicației (local în dezvoltare, apoi domeniul Vercel în producție)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# CONFIGURARE STRIPE CONNECT (OPȚIONAL — Mod Dual)
# ============================================================================
# Dacă aceste chei NU sunt completate, RentA comută automat în modul gratuit
# "Simulator Escrow Sandbox", permițând testarea completă a fluxului de plăți
# și garanții fără cont Stripe.
# Când ești gata de teste Stripe reale, ia cheile din Stripe Dashboard -> Developers -> API keys:
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================================
# CONFIGURARE RESEND EMAIL TRANZACȚIONAL (OPȚIONAL — Mod Dual)
# ============================================================================
# Dacă `RESEND_API_KEY` NU este completată, RentA rulează automat în modul
# gratuit "In-App Sandbox" (notificările apar instantaneu în Centrul de
# Notificări din aplicație, fără a necesita cont Resend).
# Pentru trimitere reală de emailuri, creează o cheie în Resend Dashboard -> API Keys:
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=RentA Store <notificari@domeniul-tau.ro>

# ============================================================================
# CONFIGURARE FACTURARE SRL & RO e-FACTURA (OPȚIONAL — Faza 14 / M14.2)
# ============================================================================
# Datele fiscale ale firmei (SRL) care operează platforma RentA și emite
# facturile de comision. Dacă lipsesc, se folosesc valorile implicite de demo.
# RENTA_ISSUER_NAME="RENTA MARKETPLACE SRL"
# RENTA_ISSUER_CUI="RO00000000"
# RENTA_VAT_RATE=19
#
# Integrare opțională Oblio.eu pentru sincronizare automată RO e-Factura ANAF:
# OBLIO_EMAIL=facturare@domeniul-tau.ro
# OBLIO_API_SECRET=cheia-ta-secreta-oblio-aici

# ============================================================================
# OBSERVABILITATE & MONITORIZARE ERORI (OPȚIONAL — Faza 16 / M16.2)
# ============================================================================
# Dacă setezi DSN-ul Sentry, `captureError()` trimite erorile sanitizate
# (fără PII: email, telefon, token-uri, CUI, IBAN) non-blocant către Sentry.
# Dacă lipsește, erorile sunt logate exclusiv structurat (JSON) în stdout/stderr.
# NEXT_PUBLIC_SENTRY_DSN=https://cheia-publica@o000000.ingest.sentry.io/0000000
